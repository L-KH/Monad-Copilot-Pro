{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "client/build/$1"
    }
  ],
  "buildCommand": "npm run vercel-build",
  "devCommand": "npm run vercel-dev",
  "outputDirectory": "client/build"
}
