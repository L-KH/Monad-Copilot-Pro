# Server Configuration
PORT=5000
NODE_ENV=development

# Claude AI API
CLAUDE_API_KEY=your-claude-api-key

# Monad Blockchain Configuration
MONAD_TESTNET_RPC_URL=https://rpc-testnet.monad.xyz
MONAD_TESTNET_EXPLORER_URL=https://explorer-testnet.monad.xyz
MONAD_DEVNET_RPC_URL=https://rpc-devnet.monad.xyz
MONAD_DEVNET_EXPLORER_URL=https://explorer-devnet.monad.xyz

# Security (for production only)
JWT_SECRET=your-jwt-secret-key-change-in-production

# Default Wallet (for testing only - NEVER store private keys in production)
DEFAULT_PRIVATE_KEY=
