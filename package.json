{
  "name": "monad-copilot-pro",
  "version": "1.0.0",
  "description": "AI-powered smart contract deployment and transaction automation suite for Monad blockchain",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "client-install": "cd client && npm install",
    "dev-full": "concurrently \"npm run dev\" \"npm run client\"",
    "setup": "npm install && npm run client-install",
    "build": "cd client && npm run build",
    "test": "jest",
    "vercel-dev": "cd client && npm start",
    "vercel-build": "cd client && npm install && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/monad-copilot-pro.git"
  },
  "keywords": [
    "monad",
    "blockchain",
    "smart-contracts",
    "AI",
    "claude",
    "automation",
    "defi",
    "web3"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.10.0",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "mongoose": "^8.0.3",
    "node-cron": "^3.0.3",
    "socket.io": "^4.7.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}