{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/next",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "client/build/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "client/build/index.html"
    }
  ],
  "buildCommand": "cd client && npm run vercel-build",
  "devCommand": "cd client && npm run dev",
  "outputDirectory": "client/build"
}
