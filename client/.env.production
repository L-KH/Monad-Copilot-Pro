# Production environment variables for Vercel deployment
# These will be used when building for production

# Flag to indicate whether to use real API or mock data
REACT_APP_USE_MOCK_DATA=false

# Monad RPC URL
REACT_APP_MONAD_RPC_URL=https://monad-testnet.rpc.io

# Build configuration
DISABLE_ESLINT_PLUGIN=true
GENERATE_SOURCEMAP=false

# Next.js specific
NEXT_PUBLIC_MONAD_RPC_URL=https://monad-testnet.rpc.io

# You'll need to set these in the Vercel dashboard
# REACT_APP_ANTHROPIC_API_KEY=
# NEXT_PUBLIC_ANTHROPIC_API_KEY=
